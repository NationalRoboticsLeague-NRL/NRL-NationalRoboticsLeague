# kitbuilder output (regenerable, not committed)
dist/

# Key material. NEVER commit, encrypted or not.
#
# tools/kitbuilder/provisioning/.gitignore already covers keys/ and *.pem, but
# it only applies to that subtree. `nrl_license.py backup --out backup/` writes
# to the REPO ROOT by default, which that file cannot see -- so a real encrypted
# signing key sat here untracked-but-not-ignored, one `git add -A` from history.
#
# Backups belong outside the working tree entirely (an encrypted volume, not a
# git checkout). These rules are the second layer, for the day someone types
# --out backup/ again out of habit.
backup/
*.pem
*.p12
*.key
license_private*
*_private_encrypted*
*_backup_sheet.html
